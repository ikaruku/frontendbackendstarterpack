# Copy of the variable names used by the backend. Contains NO real secrets.
# The real file (backend/.env) is generated by:  python scripts/setup_database.py
# Never commit backend/.env or backend/.env.admin.

# --- Application database (least-privilege role, used by the app) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=admin_panel
POSTGRES_USER=admin_panel_app
POSTGRES_PASSWORD=change-me

# --- Security ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- First admin account (created by the seed script) ---
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=change-me
